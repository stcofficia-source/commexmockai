# Server
PORT=3500
NODE_ENV=development

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI interviewer voice (English, India)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS="Speak in clear, warm Indian English with a natural Indian accent. Keep a calm, professional interview pace."

# AssemblyAI (STT)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# Comma-separated. Examples: universal-2 or universal-3-pro
ASSEMBLYAI_SPEECH_MODELS=universal-2

# STC API (PHP Backend)
STC_API_BASE_URL=http://localhost:8000
PROJECT_CRITIQUE_MODEL=gpt-4o-mini
PROJECT_CRITIQUE_MAX_OUTPUT_TOKENS=6000
# Use "strict" in production. "compatible" permits the built-in content-safety
# gate when a local/remote ClamAV engine has not been configured.
PROJECT_UPLOAD_SCAN_MODE=strict
CLAMAV_CLAMSCAN_PATH=/usr/bin/clamscan
CLAMAV_CLAMDSCAN_PATH=/usr/bin/clamdscan
CLAMAV_SOCKET=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# Session
SESSION_TTL_SECONDS=3600
MAX_QUESTIONS_PER_SESSION=10

# CORS
CORS_ORIGIN=*
